{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "havana-nice-v2-dev",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-23",
  "vars": {
    "HAVANA_ENV": "development",
    "V2_CLOUD_LINK_ENABLED": "enabled",
    "V2_CLOUD_MEDIA_ENABLED": "disabled"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "havana-nice-v2-dev",
      "database_id": "6a4abd3a-c01b-4d4f-b0ed-49f7eaca0cc5"
    }
  ],
  "services": [
    {"binding": "HAVANA_CLOUD_BRIDGE", "service": "havana-nice-cloud"}
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOMS",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
